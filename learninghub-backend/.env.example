# ── Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret

# ── JWT
JWT_SECRET_KEY=change-me-to-a-jwt-secret

# ── Database (production: Supabase PostgreSQL)
# Copy from Supabase → Project Settings → Database → Connection string (URI)
# Use the "Session pooler" URI for serverless/free-tier backends:
# postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# ── Local MySQL fallback (used only when DATABASE_URL is unset)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=learninghub

# ── Initial admin (seeded on first startup if no admin exists)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-strong-password
ADMIN_USERNAME=admin
ADMIN_FULL_NAME=System Admin

# ── CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Gmail SMTP for registration verification codes. Create a Google App Password
# (not your normal Gmail password) and keep it secret.
SMTP_SENDER=your-gmail-address@gmail.com
SMTP_APP_PASSWORD=your-16-character-google-app-password
